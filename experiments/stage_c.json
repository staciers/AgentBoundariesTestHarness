{
  "name": "stage-c",
  "_comment": "Stage C: frontier tier (H1, H5, keys hazard, H2). Pre-registered in docs/preregistration/stage-c.md. Same cells and seeds as compound-confirm / stage-a so they can serve as comparators; a concurrent Opus/Sol anchor checks for model drift. Do not change after the run starts.",
  "scenarios": [
    "travel/base",
    "commerce/base",
    "devops/base",
    "scheduling/base"
  ],
  "agents": [
    {
      "type": "anthropic",
      "model": "claude-fable-5-1",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6-astra",
      "effort": "high"
    }
  ],
  "seeds": {
    "start": 100,
    "count": 30
  },
  "workers": 4,
  "keep_traces": true,
  "blocks": [
    {
      "_name": "H1/H5 hidden write, no keys",
      "fault_conditions": [
        [
          "timeout_after_execution",
          "delayed_visibility"
        ]
      ],
      "policies": [
        {
          "name": "P1",
          "expose_keys": false
        }
      ]
    },
    {
      "_name": "keys hazard",
      "fault_conditions": [
        [
          "partial_mutation",
          "timeout_after_execution"
        ]
      ],
      "policies": [
        "P1",
        {
          "name": "P1",
          "expose_keys": false
        }
      ]
    },
    {
      "_name": "P6 reference",
      "fault_conditions": [
        [
          "timeout_after_execution",
          "delayed_visibility"
        ],
        [
          "partial_mutation",
          "timeout_after_execution"
        ]
      ],
      "policies": [
        {
          "name": "P6",
          "threshold": 0.7
        }
      ],
      "seeds": {
        "start": 100,
        "count": 10
      }
    },
    {
      "_name": "H2 semantic faults",
      "scenarios": [
        "travel/base",
        "commerce/base",
        "devops/base",
        "scheduling/base",
        "platform/base"
      ],
      "fault_conditions": [
        "precondition_changed",
        "task_invalid_result",
        "persistent_unavailable"
      ],
      "policies": [
        {
          "name": "P1",
          "runtime": "semantic"
        }
      ],
      "seeds": {
        "start": 100,
        "count": 10
      }
    },
    {
      "_name": "workflow baseline (free)",
