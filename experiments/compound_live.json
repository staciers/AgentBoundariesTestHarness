{
  "name": "compound-live",
  "_comment": "H1/H5: faults where state-checking alone fails. 4 base scenarios x 3 conditions x {P1,P6} x 2 models x 3 seeds. Dry-run first.",
  "scenarios": ["travel/base", "commerce/base", "devops/base", "scheduling/base"],
  "policies": ["P1", {"name": "P6", "threshold": 0.7}],
  "agents": [
    {"type": "anthropic", "model": "claude-opus-5-5", "effort": "high"},
    {"type": "anthropic", "model": "claude-haiku-5-5", "effort": "high"}
  ],
  "fault_conditions": [
    "timeout_after_execution",
    ["timeout_after_execution", "delayed_visibility"],
    ["partial_mutation", "timeout_after_execution"]
  ],
  "seeds": 3,
  "workers": 4,
  "keep_traces": true
}
