{
  "name": "compound-live",
  "_comment": "H1/H5: faults where state-checking alone fails, plus a no-keys ablation of P1. Model pairs matched by tier: Opus 5.5 ~ gpt-6.1-sol, Haiku 5.5 ~ gpt-6-luna. Dry-run first.",
  "scenarios": [
    "travel/base",
    "commerce/base",
    "devops/base",
    "scheduling/base"
  ],
  "policies": [
    "P1",
    {
      "name": "P1",
      "expose_keys": false
    },
    {
      "name": "P6",
      "threshold": 0.7
    }
  ],
  "agents": [
    {
      "type": "anthropic",
      "model": "claude-opus-5-5",
      "effort": "high"
    },
    {
      "type": "anthropic",
      "model": "claude-haiku-5-5",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6-luna",
      "effort": "high"
    }
  ],
  "fault_conditions": [
    "timeout_after_execution",
    [
      "timeout_after_execution",
      "delayed_visibility"
    ],
    [
      "partial_mutation",
      "timeout_after_execution"
    ]
  ],
  "seeds": 3,
  "workers": 4,
  "keep_traces": true
}
