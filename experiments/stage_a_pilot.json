  "agents": [
    {
      "type": "anthropic",
      "model": "claude-opus-5-5",
      "effort": "high"
    },
    {
      "type": "anthropic",
      "model": "claude-haiku-5-5",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6-luna",
      "effort": "high"
    }
  ],
  "seeds": {
    "start": 900,
    "count": 1
  },
  "fault_conditions": [
    "none",
    "precondition_changed",
    "task_invalid_result",
    "persistent_unavailable",
