cimal import Decimal, ROUND_UP, localcontext\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_rounds_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n\n\ndef test_rounding_is_independent_of_decimal_context():\n    with localcontext() as context:\n        context.rounding = ROUND_UP\n        assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 18382, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_0zWS8A2wqlmMWQAbYBKJcVUW", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18382, "event": "agent_result", "actor": "control_plane", "call_id": "call_0zWS8A2wqlmMWQAbYBKJcVUW", "kind": "ok", "is_error": false}, {"t_ms": 20627, "event": "agent_call", "actor": "agent", "call_id": "call_NH5ZBay96Uzl8l2UwYjaDSko", "tool": "trigger_ci", "args": {"ref": "ae55f6774d", "idempotency_key": "fin-212-half-even-ae55f6774d"}, "confidence": null}, {"t_ms": 20927, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_NH5ZBay96Uzl8l2UwYjaDSko", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "fin-212-half-even-ae55f6774d", "malformed": false}, {"t_ms": 20927, "event"