ze(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n\n\ndef test_exact_cents():\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}], "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 19143, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_jJFqOwruO5GeowkLZwQcRwiq", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 19143, "event": "agent_result", "actor": "control_plane", "call_id": "call_jJFqOwruO5GeowkLZwQcRwiq", "kind": "ok", "is_error": false}, {"t_ms": 21471, "event": "agent_call", "actor": "agent", "call_id": "call_d6CdDXZZHjiBwX7nnhCyjU8b", "tool": "trigger_ci", "args": {"ref": "c3ce45fe6b", "idempotency_key": "ci-fin-212-c3ce45fe6b", "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 21771, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_d6CdDXZZHjiBwX7nnhCyjU8b", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "ci-fin-212-c3ce45fe6b", "malformed": false}, {"t_ms": 21771, "event": "agent_re