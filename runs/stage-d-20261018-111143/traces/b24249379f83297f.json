round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_non_midpoint_rounding():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"-2.664\\\")) == Decimal(\\\"-2.66\\\")\\n    assert round_money(Decimal(\\\"-2.666\\\")) == Decimal(\\\"-2.67\\\")\\n\\n\\ndef test_rounding_is_independent_of_decimal_context():\\n    with localcontext() as context:\\n        context.rounding = ROUND_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\\n\"}]}", "call_id": "call_NYqFBYEJ0gIxzeIUjX2e4VR2", "name": "commit_changes", "type": "function_call", "id": "fc_0ce03152c896b909006ad550650d3887d0931c7704c41ce170", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ce03152c896b909006ad5506bf73887d0a41e98e5c81cc5d6", "status": "completed", "output": [{"arguments": "{\"ref\":\"fix/fin-212-half-even-rounding\",\"idempotency_key\":\"ci-fin-212-0e5f2d8b72\"}", "call_id": "call_jYvjWtKBnD502417q529ztjt", "name": "trigger_ci", "type": "function_call", "id": "fc_0ce03152c896b909006ad5506d3e0887d090d2096afb89cb42", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ce03152c896b909006ad5506e61c887d085db9c062ce3ba90", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_ivD0z4rPbRALHcM3hygZ274y", "name": "wait_for_ci", "type": "function_call", "id": "fc_0ce03152c896b909006ad5506f8f0087d0a91621df9cc2c177", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ce03152c896b909006ad55070566c87d08fc1061b2eb3dfd6", "status": "completed", "output": [{"arguments":