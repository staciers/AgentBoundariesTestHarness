n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}],\"confidence\":0.99}", "call_id": "call_MYgnTzPLl7YUJI4CDTOX2IT0", "name": "commit_changes", "type": "function_call", "id": "fc_0d5894236c6415e3006ad55e23a31887d09b39c1b14d14e07b", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0d5894236c6415e3006ad55e28e49887d08aae14b230c2b051", "status": "completed", "output": [{"arguments": "{\"ref\":\"d5638f3ae7\",\"idempotency_key\":\"ci-fin-212-d5638f3ae7\",\"confidence\":0.99}", "call_id": "call_TGnXJ7ZLrKLqbjlfdxX5Z3n9", "name": "trigger_ci", "type": "function_call", "id": "fc_0d5894236c6415e3006ad55e2a626087d08f9cc632abadb99d", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0d5894236c6415e3006ad55e2b9b9087d0a1f4f6cbccc2b57d", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900,\"confidence\":0.99}", "call_id": "call_SrhfOClb1ypkdEDUestRkbi4", "name": "wait_for_ci", "type": "function_call", "id": "fc_0d5894236c6415e3006ad55e2cba6087d08ce5a3effdff54f5", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0d5894236c6415e3006ad55e2d71ec87d09032502d9187239d", "status": "completed", "output": [{"arguments": "{\"he