oney(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\\n\\ndef test_half_even_ignores_context_rounding():\\n    with localcontext() as context:\\n        context.rounding = ROUND_HALF_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}],\"confidence\":0.99}", "call_id": "call_H7Aujre7YWf0Os0gr8Km1qgb", "name": "commit_changes", "type": "function_call", "id": "fc_0fa6d2deacaddfca006ad5500f47f087d0833c9972d4aa68c8", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0fa6d2deacaddfca006ad55014f30087d0bd0640e640e9cd3d", "status": "completed", "output": [{"arguments": "{\"ref\":\"42000e6460\",\"idempotency_key\":\"ci-fin-212-42000e6460\",\"confidence\":0.99}", "call_id": "call_zvqNGTxUCruJSoA9Se9lfz5d", "name": "trigger_ci", "type": "function_call", "id": "fc_0fa6d2deacaddfca006ad5501607e087d0b2d2be3069307605", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0fa6d2deacaddfca006ad5501743b887d0aad2437afb9bc3de", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900,\"confidence\":0.99}", "call_id": "call_7xVJvuv7W7GdufUi0BiDv3Ac", "name": "wait_for_ci", "type": "function_call", "id": "fc_0fa6d2deacaddfca006ad55018895887d0b487103b036ba520", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0fa6d2deacaddfca006ad5501954dc87d0b05692020ff2d6bd", "status": "completed", "output": [{"arguments": "{\"head\":\"fix/fin-212-half-even-rounding\",\"base\":\"main\",\"title\":\"Fix money rounding to ROUND_HALF_EVEN (FIN-212)\",\"body\":\"## Summary\\n- Use ROUND_HALF