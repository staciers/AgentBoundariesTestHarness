\\\"\\n    return amount.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_EVEN)\\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_non_tie_rounding():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"-2.664\\\")) == Decimal(\\\"-2.66\\\")\\n    assert round_money(Decimal(\\\"-2.666\\\")) == Decimal(\\\"-2.67\\\")\\n\\n\\ndef test_exact_cents():\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"0\\\")) == Decimal(\\\"0.00\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\\n\"}]}", "call_id": "call_D0zgVApH3Mtm67eWzOAa3Jk8", "name": "commit_changes", "type": "function_call", "id": "fc_0512745f94b4b5e7006ad54f45c8bc87d09abf0c56516ec035", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0512745f94b4b5e7006ad54f4ba54087d091ec0096e9d1ef72", "status": "completed", "output": [{"arguments": "{\"ref\":\"1a9ad5c752\",\"idempotency_key\":\"ci-fin-212-half-even-1a9ad5c752\"}", "call_id": "call_vBFw1xvH3xd9zesaNyCgE52p", "name": "trigger_ci", "type": "function_call", "id": "fc_0512745f94b4b5e7006ad54f4cf96887d081bccc914396e64c", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0512745f94b4b5e7006ad54f4e0be88