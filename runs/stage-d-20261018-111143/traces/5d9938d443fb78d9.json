ntent": "from decimal import Decimal, ROUND_HALF_EVEN\n\n\ndef round_money(amount: Decimal) -> Decimal:\n    \"\"\"Round to cents using banker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal, ROUND_HALF_UP, localcontext\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_round_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n\n\ndef test_rounding_independent_of_decimal_context():\n    with localcontext() as context:\n        context.rounding = ROUND_HALF_UP\n        assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")\n"}], "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 19100, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_qKglTa10zprxnhbsDsAbcJJZ", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 19100, "event": "agent_result", "actor": "control_plane", "call_id": "call_qKglTa10zprxnhbsDsAbcJJZ", "kind": "ok", "is_error": false}, {"t_ms": 21961, "event": "agent_call", "actor": "agent", "call_id": "call_z30hRfGzSYv6v7gk6IjSvbd7", "tool": "trigger_ci", "args": {"ref": "e3282d3b5f", "idempotency_key": "ci-fin-212-e3282d3b5f", "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 22261, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_z30hRfGzSYv6v7gk6IjSvbd7", "tool": "trigger_ci", "state": "EX