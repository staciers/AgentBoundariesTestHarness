ker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal, ROUND_HALF_UP, localcontext\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n\n\ndef test_half_even_ignores_context_rounding():\n    with localcontext() as context:\n        context.rounding = ROUND_HALF_UP\n        assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 18232, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_tkqBX6qk9iFqAKRrqgfggXLl", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18232, "event": "agent_result", "actor": "control_plane", "call_id": "call_tkqBX6qk9iFqAKRrqgfggXLl", "kind": "ok", "is_error": false}, {"t_ms": 20297, "event": "agent_call", "actor": "agent", "call_id": "call_rmzkKJfavUN2IBQ5kpxAC6xM", "tool": "trigger_ci", "args": {"ref": "680eff86fb", "idempotency_key": "ci-fin-212-680eff86fb"}, "confidence": null}, {"t_ms": 20597, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_rmzkKJfavUN2IBQ5kpxAC6xM", "tool": 