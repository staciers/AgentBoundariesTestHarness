imal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_half_even_ignores_context_rounding():\\n    with localcontext() as context:\\n        context.rounding = ROUND_HALF_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n        assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_non_tie_rounding():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n\"}]}", "call_id": "call_FckxDvc04ptqlJmZOlROtpYq", "name": "commit_changes", "type": "function_call", "id": "fc_09c4721945cf1a73006ad55159e4f087d08334458f29ce8f33", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_09c4721945cf1a73006ad5515f1ff087d0b3813cc7eab392b5", "status": "completed", "output": [{"arguments": "{\"ref\":\"93cebec81b\",\"idempotency_key\":\"payments-fin-212-ci-93cebec81b\"}", "call_id": "call_0KQAWRyRdb1jRrTgcrMVguSQ", "name": "trigger_ci", "type": "function_call", "id": "fc_09c4721945cf1a73006ad55160d1d887d0a2fc7122f817e9f6", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_09c4721945cf1a73006ad55161e35887d0b516d5923d157a42", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_CJgD6k5VuzgkQYqWbf0fF5Se", "name": "wait_for_ci", "type": "function_call", "id": "fc_09c4721945cf1a73006ad55163331087d09696ced5b567e318", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_09c4721945cf1a73006ad55163e3c087d0811d22d4d6a068d3", "status": "completed", "output": [{"arguments": "{\"head\":\"fix/fin-212-half-even-rounding\",\"base\":\"main\",\"title\":\"Fix money rounding to use ROUND_HALF_EVEN (FIN-212)\",\"body\":\"## Summary\\n- Use ROUND_HALF_EVEN explicitly when rounding monetary amounts to cents, as required by FIN-212.\\n- Add regres