ng\\n\\n\\ndef test_half_even_negative_amounts():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n\\n\\ndef test_round_money_uses_half_even_regardless_of_context():\\n    with localcontext() as context:\\n        context.rounding = ROUND_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\\n\\ndef test_round_money_preserves_cent_precision():\\n    assert str(round_money(Decimal(\\\"2\\\"))) == \\\"2.00\\\"\\n    assert str(round_money(Decimal(\\\"0\\\"))) == \\\"0.00\\\"\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix monetary rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}]}", "call_id": "call_lib0Q3ehSW5HCWGu8TZNJ3KX", "name": "commit_changes", "type": "function_call", "id": "fc_0f13ee4e306cd573006ad54c6d547887d09382c77cc7595900", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0f13ee4e306cd573006ad54c73f6f087d0bc524e985ed91194", "status": "completed", "output": [{"arguments": "{\"ref\":\"fix/fin-212-half-even-rounding\",\"idempotency_key\":\"ci-fin-212-3acc820ba4\"}", "call_id": "call_18jvpW3mVJcjaPYkMP5ZRERd", "name": "trigger_ci", "type": "function_call", "id": "fc_0f13ee4e306cd573006ad54c7561e887d091182858b8ba4254", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0f13ee4e306cd573006ad54c76452c87d08f5f733ab6285e0c", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_lro8paWOSvS6CqP4mw2ldUmz", "name": "wait_for_ci", "type": "function_call", "id": "fc_0f13ee4e306cd573006ad54c7759ac87d0a6185e87ff2ce223", "async_": null,