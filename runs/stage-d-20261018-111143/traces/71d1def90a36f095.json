mal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 18562, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_jZUo5SlYCDv8NmlF7eYVi5vp", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18562, "event": "agent_result", "actor": "control_plane", "call_id": "call_jZUo5SlYCDv8NmlF7eYVi5vp", "kind": "ok", "is_error": false}, {"t_ms": 20752, "event": "agent_call", "actor": "agent", "call_id": "call_xnWpBnpZvINAq0AgonoO3Vso", "tool": "trigger_ci", "args": {"ref": "09acffbc5a", "idempotency_key": "payments-fin-212-ci-09acffbc5a"}, "confidence": null}, {"t_ms": 21052, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_xnWpBnpZvINAq0AgonoO3Vso", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "payments-fin-212-ci-09acffbc5a", "malformed": false}, {"t_ms": 21052, "event": "agent_result", "actor": "control_plane", "call_id": "call_xnWpBnpZvINAq0AgonoO3Vso", "kind": "ok", "is_error": false}, {"t_ms": 23000, "event": "agent_call", "actor": "agent", "call_id": "call_hvQBOzQs