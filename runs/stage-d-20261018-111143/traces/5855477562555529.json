 amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal, ROUND_HALF_UP, localcontext\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_round_money_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n\n\ndef test_half_even_ignores_context_rounding():\n    with localcontext() as context:\n        context.rounding = ROUND_HALF_UP\n        assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")\n"}], "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 17243, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_1o5XppfcWiCfiwcYPSfdOg9d", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 17243, "event": "agent_result", "actor": "control_plane", "call_id": "call_1o5XppfcWiCfiwcYPSfdOg9d", "kind": "ok", "is_error": false}, {"t_ms": 19518, "event": "agent_call", "actor": "agent", "call_id": "call_Rlaub5ZDo8P7W0E2xhvBfUX8", "tool": "trigger_ci", "args": {"ref": "1aa9d4e4f0", "idempotency_key": "ci-fin-212-1aa9d4e4f0", "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 19818, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_Rlaub5ZDo8P7W0E2xhvBfUX8", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "ci-fin-212-1aa9d4e4f0", "malformed": false}, {"t_ms": 19818, "event":