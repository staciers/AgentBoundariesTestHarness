)) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\\n\\ndef test_half_even_ignores_context_rounding():\\n    with localcontext() as context:\\n        context.rounding = ROUND_HALF_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\\n\"}]}", "call_id": "call_Tzg8PMqqSPu7T75XxYaxWwAj", "name": "commit_changes", "type": "function_call", "id": "fc_0206e6a00605ed89006ad54e938cd887d086031950295444f0", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0206e6a00605ed89006ad54e99c35087d09aa9cbbc8ce35c8a", "status": "completed", "output": [{"arguments": "{\"ref\":\"f389961c51\",\"idempotency_key\":\"ci-fin-212-f389961c51\"}", "call_id": "call_T2SeqVblm7Z1fihb3LdXeJMB", "name": "trigger_ci", "type": "function_call", "id": "fc_0206e6a00605ed89006ad54e9ae22087d0bae244520ec6e327", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0206e6a00605ed89006ad54e9bf4cc87d0afde0657f489ccc2", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_jat3XFURLcvXrYrLJm6St7AT", "name": "wait_for_ci", "type": "function_call", "id": "fc_0206e6a00605ed89006ad54e9d563c87d0994f0f6b49060182", "async_": null, "caller": null, "namespace": null, 