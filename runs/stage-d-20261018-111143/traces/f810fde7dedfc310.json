sing banker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_negative_half_even():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_tie_rounding():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 17662, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_cD6A9ZWgbXdcSoqQp14Rv9YM", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 17662, "event": "agent_result", "actor": "control_plane", "call_id": "call_cD6A9ZWgbXdcSoqQp14Rv9YM", "kind": "ok", "is_error": false}, {"t_ms": 20092, "event": "agent_call", "actor": "agent", "call_id": "call_Cyq33yf7GFXEnlaFNcLkMi8M", "tool": "trigger_ci", "args": {"ref": "2e32204f6d", "idempotency_key": "ci-fin-212-2e32204f6d"}, "confidence": null}, {"t_ms": 20392, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_Cyq33yf7GFXEnlaFNcLkMi8M", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "ci-fin-212-2e32204f6d", "malformed": false}, {"t_ms": 