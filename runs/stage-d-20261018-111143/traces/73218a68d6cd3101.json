ey(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\\n\\ndef test_half_even_ignores_context_rounding():\\n    with localcontext() as context:\\n        context.rounding = ROUND_HALF_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}]}", "call_id": "call_9mWa2B9ABvl3ynLLypBvDrjh", "name": "commit_changes", "type": "function_call", "id": "fc_04a85d7c858ea0ab006ad54cb76a5487d0b4004f65114d7241", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_04a85d7c858ea0ab006ad54cbd3ba887d0b79dd6b81413a2fa", "status": "completed", "output": [{"arguments": "{\"ref\":\"680eff86fb\",\"idempotency_key\":\"ci-fin-212-680eff86fb\"}", "call_id": "call_bdasG5F43Bay2MwgRBjhAJlX", "name": "trigger_ci", "type": "function_call", "id": "fc_04a85d7c858ea0ab006ad54cbecc5887d0ace34cea3ed76a7e", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_04a85d7c858ea0ab006ad54cbfac1487d0905ff99e65722d59", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_n3FICdWRKjjC98MMpvd0g6UJ", "name": "wait_for_ci", "type": "function_call", "id": "fc_04a85d7c858ea0ab006ad54cc0da1487d09b0e5a810f6b1bab", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_04a85d7c858ea0ab006ad54cc180c887d081bad6fcad075944", "status": "completed", "output": [{"arguments": "{\"head\":\"fix/fin-212-half-even-rounding\",\"base\":\"main\",\"title\":\"Fix FIN-212 banker's rounding for money\",\"bod