g banker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal, ROUND_HALF_UP, localcontext\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative_amounts():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_tie_amounts():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n\n\ndef test_half_even_ignores_context_rounding():\n    with localcontext() as context:\n        context.rounding = ROUND_HALF_UP\n        assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 18077, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_OQgHRrtyqtxH66IOLIgINliO", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18077, "event": "agent_result", "actor": "control_plane", "call_id": "call_OQgHRrtyqtxH66IOLIgINliO", "kind": "ok", "is_error": false}, {"t_ms": 21019, "event": "agent_call", "actor": "agent", "call_id": "call_Kkfd8SA3DYfhi0On16Bz7jym", "tool": "trigger_ci", "args": {"ref": "7ffa71e879", "idempotency_key": "ci-fin-212-7ffa71e879"}, "confidence": null}, {"t_ms": 21319, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_Kkfd8SA3DYfhi0On16Bz7jym", "tool": "trigger_ci", "state": "EXECUTED", "error_ki