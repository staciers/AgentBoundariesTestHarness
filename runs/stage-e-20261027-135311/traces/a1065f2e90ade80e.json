test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative_amounts():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_round_money_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix monetary rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 16619, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_FD53SfAIjnHCRMz8joTBVNsf", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 16619, "event": "agent_result", "actor": "control_plane", "call_id": "call_FD53SfAIjnHCRMz8joTBVNsf", "kind": "ok", "is_error": false}, {"t_ms": 18856, "event": "agent_call", "actor": "agent", "call_id": "call_5rAv1uDfaa8M6uCbTY0gno0K", "tool": "trigger_ci", "args": {"ref": "c483afa5c9", "idempotency_key": "ci-fin-212-c483afa5c9"}, "confidence": null}, {"t_ms": 19156, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_5rAv1uDfaa8M6uCbTY0gno0K", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "ci-fin-212-c483afa5c9", "malformed": false}, {"t_ms": 19156, "event": "agent_result", "actor": "control_plane", "call_id": "call_5rAv1uDfaa8M6uCbTY0gno0K", "kind": "ok", "is_error": false}, {"t_ms": 20843, "event": "agent_call", "actor": "agent", "call_id": "call_ERTTZgl75JsXwAd3kv7fGJce", "to