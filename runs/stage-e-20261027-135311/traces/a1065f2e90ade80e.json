n    \\\"\\\"\\\"Round to cents using banker's rounding (ROUND_HALF_EVEN), per FIN-212.\\\"\\\"\\\"\\n    return amount.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_EVEN)\\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative_amounts():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix monetary rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}]}", "call_id": "call_FD53SfAIjnHCRMz8joTBVNsf", "name": "commit_changes", "type": "function_call", "id": "fc_0c52187a053159df006ae116c8b22887d09e24f3974cf4b597", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0c52187a053159df006ae116cbfc3487d0943bac1a725a2408", "status": "completed", "output": [{"arguments": "{\"ref\":\"c483afa5c9\",\"idempotency_key\":\"ci-fin-212-c483afa5c9\"}", "call_id": "call_5rAv1uDfaa8M6uCbTY0gno0K", "name": "trigger_ci", "type": "function_call", "id": "fc_0c52187a053159df006ae116cd13dc87d0aaf56dd220d34342", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0c52187a053159df006ae116cde74487d09b16f87d47b3f374", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_ERTTZgl75JsXwAd3kv7f