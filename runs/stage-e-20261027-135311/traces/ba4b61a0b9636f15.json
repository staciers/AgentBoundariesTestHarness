n_pr", "args": {"head": "fix/fin-212-bankers-rounding", "base": "main", "title": "Fix round_money to use banker's rounding (ROUND_HALF_EVEN), per FIN-212", "body": "The nightly build was failing because `tests/test_money.py::test_half_even` expects banker's rounding (FIN-212), but `src/money.py` used `ROUND_HALF_UP` despite its docstring.\n\nChange: switch `round_money` to `ROUND_HALF_EVEN`.\n\nCI: run ci-0001 passed on 08d3cd5986.", "reviewers": ["alex"], "idempotency_key": "pr-fin-212-bankers-rounding"}, "confidence": null}, {"t_ms": 376450, "event": "runtime_outcome", "actor": "runtime", "call_id": "toolu_01DhGMCZp51Uq81GiPfYG2UE", "tool": "open_pr", "state": "SEMANTIC_FAILURE", "error_kind": "business_error", "error_message": "fix/fin-212-bankers-rounding is behind main; update the branch before opening a pull request", "attempts": 1, "runtime_actions": [], "failure_class": "semantic", "idempotency_key": "pr-fin-212-bankers-rounding", "malformed": false}, {"t_ms": 376450, "event": "agent_result", "actor": "control_plane", "call_id": "toolu_01DhGMCZp51Uq81GiPfYG2UE", "kind": "rejected", "is_error": true}, {"t_ms": 378655, "event": "agent_call", "actor": "agent", "call_id": "toolu_01K59GdmTXmiaANnisizUCwZ", "tool": "update_branch", "args": {"branch": "fix/fin-212-bankers-rounding"}, "confidence": null}, {"t_ms": 379455, "event": "runtime_outcome", "actor": "runtime", "call_id": "toolu_01K59GdmTXmiaANnisizUCwZ", "tool": "update_branch", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 379455, "event": "agent_result", "actor": "control_plane", "call_id": "toolu_01K59GdmTXmiaANnisizUCwZ", "kind": "ok", "is_error": false}, {"t_ms": 381890, "event": "agent_call", "actor": "agent", "call_id": "toolu_01TjrNbPvnArfo9vC9QNaEWy", "tool": "read_file", "args": {"path": "src/money.py", "ref": "fix/fin-212-bankers-rounding"}, "confidence": null}, {"