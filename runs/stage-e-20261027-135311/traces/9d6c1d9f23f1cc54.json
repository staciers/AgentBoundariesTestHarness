per FIN-212.\\\"\\\"\\\"\\n    return amount.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_EVEN)\\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n\\n\\ndef test_preserve_cent_precision():\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"0\\\")) == Decimal(\\\"0.00\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use banker's rounding (`ROUND_HALF_EVEN`), per FIN-212.\\n\"}],\"confidence\":0.99}", "call_id": "call_n4aZpIkMEwPmXoYWQF8NLxxI", "name": "commit_changes", "type": "function_call", "id": "fc_009dba7905f69322006ae116e0de1c87d08034bbb953790cfa", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_009dba7905f69322006ae116e44e8087d0a8f5dbfd4e4da50c", "status": "completed", "output": [{"arguments": "{\"ref\":\"628ed99dc7\",\"idempotency_key\":\"fin-212-half-even-628ed99dc7\",\"confidence\":0.99}", "call_id": "call_lgZdbzRshLgwVE8uJWDx5VUB", "name": "trigger_ci", "type": "function_call", "id": "fc_009dba7905f69322006ae116e580ec87d0bc3cd98fcc913fde", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_009dba7905f69322006ae116e671f487d090639b90d23e5280", "status": "completed", "output": [{"arguments": "{\"run_id\":