, "latency_ms": 289716, "hint": {"service": "payments-worker"}, "erred": false}, {"t_ms": 308464, "event": "agent_call", "actor": "agent", "call_id": "toolu_01WGY8Lw65oQ8ozQ3s5qgi7d", "tool": "rollback", "args": {"service": "payments-worker", "version": "v3.3.0"}, "confidence": null}, {"t_ms": 312464, "event": "runtime_outcome", "actor": "runtime", "call_id": "toolu_01WGY8Lw65oQ8ozQ3s5qgi7d", "tool": "rollback", "state": "VERIFIED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": ["postcondition_verified"], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 312464, "event": "agent_result", "actor": "control_plane", "call_id": "toolu_01WGY8Lw65oQ8ozQ3s5qgi7d", "kind": "ok", "is_error": false}, {"t_ms": 316970, "event": "agent_call", "actor": "agent", "call_id": "toolu_01RabzEL93zQXWniYSufavwV", "tool": "create_incident", "args": {"title": "payments-worker v3.4.0 errors; rolled back to v3.3.0", "severity": "SEV2", "service": "payments-worker", "summary": "After this morning's deploy of payments-worker v3.4.0, the worker became unhealthy with an 18% error rate in us-east, us-west and eu-west. payments-api (v5.1.0) is also degraded at 18%, which we think is downstream of the worker. payments-worker has been rolled back to v3.3.0, its last healthy production release, in all regions. Next: confirm payments-worker and payments-api recover, and find the root cause in v3.4.0.", "idempotency_key": "payments-worker-v3.4.0-rollback-sev2"}, "confidence": null}, {"t_ms": 317570, "event": "runtime_outcome", "actor": "runtime", "call_id": "toolu_01RabzEL93zQXWniYSufavwV", "tool": "create_incident", "state": "VERIFIED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": ["postcondition_verified"], "failure_class": null, "idempotency_key": "payments-worker-v3.4.0-rollback-sev2", "malformed": false}, {"t_ms": 317570, "event": "agent_result", "actor": "control_plane", "call_id": "toolu_01RabzEL93zQXWniYSu