imal so no float issue.\n\nCreate branch, commit fix.", "tool_calls": [{"id": "call_01a13bd35cc2743b91bb7a7a", "function": {"arguments": "{\"branch\":\"fix-bankers-rounding-fin212\"}", "name": "create_branch"}, "type": "function"}]}, {"served_model": "zai-org/GLM-5.3-Flash", "system_fingerprint": "default", "finish_reason": "tool_calls", "content": null, "reasoning_content": null, "tool_calls": [{"id": "call_01a13bd360a270a0b2db8696", "function": {"arguments": "{\"branch\":\"fix-bankers-rounding-fin212\",\"files\":[{\"content\":\"from decimal import Decimal, ROUND_HALF_EVEN\\n\\n\\ndef round_money(amount: Decimal) -> Decimal:\\n    \\\"\\\"\\\"Round to cents using banker's rounding (ROUND_HALF_EVEN), per FIN-212.\\\"\\\"\\\"\\n    return amount.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_EVEN)\\n\",\"path\":\"src/money.py\"}],\"message\":\"Fix round_money to use banker's rounding (ROUND_HALF_EVEN) per FIN-212\"}", "name": "commit_changes"}, "type": "function"}]}, {"served_model": "zai-org/GLM-5.3-Flash", "system_fingerprint": "default", "finish_reason": "tool_calls", "content": null, "reasoning_content": null, "tool_calls": [{"id": "call_01a13bd362847540b4c995f9", "function": {"arguments": "{\"ref\":\"fix-bankers-rounding-fin212\"}", "name": "trigger_ci"}, "type": "function"}]}, {"served_model": "zai-org/GLM-5.3-Flash", "system_fingerprint": "default", "finish_reason": "tool_calls", "content": null, "reasoning_content": null, "tool_calls": [{"id": "call_01a13bd363ff73d3b9700243", "function": {"arguments": "{\"run_id\":\"ci-0001\"}", "name": "wait_for_ci"}, "type": "function"}]}, {"served_model": "zai-org/GLM-5.3-Flash", "system_fingerprint": "default", "finish_reason": "tool_calls", "content": null, "reasoning_content": null, "tool_calls": [{"id": "call_01a13bd368f674628b5a45ec", "function": {"arguments": "{\"base\":\"main\",\"body\":\"Fixes the nightly build failure: `round_money` in `src/money.py` was using `ROUND_HALF_UP` instead of banker's rounding (`RO