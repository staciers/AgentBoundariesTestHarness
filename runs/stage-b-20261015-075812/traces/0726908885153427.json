e(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_EVEN)\\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_non_tie_rounding():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n\\n\\ndef test_exact_cents():\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\"}]}", "call_id": "call_uyvomwdWD5io2bx95XDcURHH", "name": "commit_changes", "type": "function_call", "id": "fc_01b0f5d8a0d25112006ad25b5e87a887d0bd55c8a6543a79e2", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_01b0f5d8a0d25112006ad25b631aec87d0b07cd5da7c80dc22", "status": "completed", "output": [{"arguments": "{\"ref\":\"89cd20f63f\",\"idempotency_key\":\"ci-fin-212-89cd20f63f\"}", "call_id": "call_SIymNyHpev43c9kRLqnGgokA", "name": "trigger_ci", "type": "function_call", "id": "fc_01b0f5d8a0d25112006ad25b64c2fc87d08c0af5b0630bc863", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_01b0f5d8a0d25112006ad25b65f0c087d0896fa22a249ed36a", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_juXeYRslXBBWfJzaSkQp8r99", "name": "wait_for_ci", "type": "function_call", "id": "fc_01b0f5d8a0d25112006ad25b67532c87d08ec8740d777d3507", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_01b0f5d8a0d25112006ad25b67f26087d0b19cedb6e10f10b4", "