OUND_HALF_EVEN)\\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal, ROUND_HALF_UP, localcontext\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative_amounts():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_half_even_independent_of_decimal_context():\\n    with localcontext() as context:\\n        context.rounding = ROUND_HALF_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\\n\\ndef test_round_to_cents():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}],\"confidence\":0.99}", "call_id": "call_Pl7z57AbuGLfIfrUvFlV9QQT", "name": "commit_changes", "type": "function_call", "id": "fc_0506311956868c18006ad259eb535487d097661066f91daeec", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0506311956868c18006ad259f1beec87d096cdc741093b56f5", "status": "completed", "output": [{"arguments": "{\"ref\":\"efc399d486\",\"idempotency_key\":\"payments-fin-212-efc399d486-ci\",\"confidence\":0.99}", "call_id": "call_rmo5w9E20w6H6yopPvtUsq7L", "name": "trigger_ci", "type": "function_call", "id": "fc_0506311956868c18006ad259f396c087d093fc439f1c02087f", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0506311956868c18006ad259f50ee487d09e1073d8cd7061b2", "stat