ing banker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n\n\ndef test_exact_cents():\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 18215, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_3z8iWbTe8bPBH0C6dBpGlBEs", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18215, "event": "agent_result", "actor": "control_plane", "call_id": "call_3z8iWbTe8bPBH0C6dBpGlBEs", "kind": "ok", "is_error": false}, {"t_ms": 21135, "event": "agent_call", "actor": "agent", "call_id": "call_LPBuMG6MznZcSm9nSYAWWt04", "tool": "trigger_ci", "args": {"ref": "c3ce45fe6b", "idempotency_key": "fin-212-ci-c3ce45fe6b"}, "confidence": null}, {"t_ms": 21435, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_LPBuMG6MznZcSm9nSYAWWt04", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "fin-212-ci-c3ce45fe6b", "malformed