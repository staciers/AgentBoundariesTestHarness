l import Decimal, ROUND_HALF_EVEN\n\n\ndef round_money(amount: Decimal) -> Decimal:\n    \"\"\"Round to cents using banker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_non_tie_rounding():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\n"}], "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 18241, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_3PLhtnOcMIYY1QfwMLDdFrDP", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18241, "event": "agent_result", "actor": "control_plane", "call_id": "call_3PLhtnOcMIYY1QfwMLDdFrDP", "kind": "ok", "is_error": false}, {"t_ms": 21026, "event": "agent_call", "actor": "agent", "call_id": "call_AJ2OuYDC9tBVNpYUX9rcKlkj", "tool": "trigger_ci", "args": {"ref": "fix/fin-212-half-even-rounding", "idempotency_key": "fin-212-half-even-ci-710dc7ea3a", "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 21326, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_AJ2OuYDC9tBVNpYUX9rcKlkj", "tool": "trigger_ci", "state": "EXECUTED