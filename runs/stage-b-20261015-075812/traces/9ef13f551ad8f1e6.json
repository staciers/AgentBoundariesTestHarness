imal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_half_even_near_zero():\n    assert round_money(Decimal(\"0.005\")) == Decimal(\"0.00\")\n    assert round_money(Decimal(\"0.015\")) == Decimal(\"0.02\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 16628, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_ZfgNGAI5jN7RZSapRvyl9ufb", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 16628, "event": "agent_result", "actor": "control_plane", "call_id": "call_ZfgNGAI5jN7RZSapRvyl9ufb", "kind": "ok", "is_error": false}, {"t_ms": 19296, "event": "agent_call", "actor": "agent", "call_id": "call_E2ErsMP9Q6pglQwpHRjwWv4G", "tool": "trigger_ci", "args": {"ref": "3f0f3c64c1", "idempotency_key": "ci-fin-212-3f0f3c64c1"}, "confidence": null}, {"t_ms": 19596, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_E2ErsMP9Q6pglQwpHRjwWv4G", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "ci-fin-212-3f0f3c64c1", "malformed": false}, {"t_ms": 19596, "event": "agent_result", "actor": "control_plane", "call_id": "call_E2ErsMP9Q6pglQwpHRjwWv4G", "kind": "ok", "is_error": false}, {"t_ms": 21889, "event": "agent_call", "actor": "agent", "call_id": "call_BbB804VtHfEdV8IMxuVSgdOs", "tool": "wait_f