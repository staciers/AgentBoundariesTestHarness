ker's rounding (ROUND_HALF_EVEN), per FIN-212.\\\"\\\"\\\"\\n    return amount.quantize(Decimal(\\\"0.01\\\"), rounding=ROUND_HALF_EVEN)\\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_half_even_near_zero():\\n    assert round_money(Decimal(\\\"0.005\\\")) == Decimal(\\\"0.00\\\")\\n    assert round_money(Decimal(\\\"0.015\\\")) == Decimal(\\\"0.02\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n\"}]}", "call_id": "call_DuoxZkUxAvQqmdEOYx1W1r2a", "name": "commit_changes", "type": "function_call", "id": "fc_0ae4d760a7cd2cff006ad25780ad5487d0a296cc16e145814d", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ae4d760a7cd2cff006ad25785884887d087786f6ac073dceb", "status": "completed", "output": [{"arguments": "{\"ref\":\"6c862cb9e4\",\"idempotency_key\":\"fin-212-half-even-6c862cb9e4\"}", "call_id": "call_wAlLytfrVTVWDOsbJv2TrcqP", "name": "trigger_ci", "type": "function_call", "id": "fc_0ae4d760a7cd2cff006ad2578700d087d092d8b496408d4168", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ae4d760a7cd2cff006ad25788381487d0ac300938e5dcab2b", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_ILzArIRAERidznTSzAxhQa5K", "name": "wa