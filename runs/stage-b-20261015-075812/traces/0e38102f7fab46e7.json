mal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}]}, "confidence": null}, {"t_ms": 52060, "event": "escalation", "actor": "control_plane", "id": "esc2", "kind": "approval", "trigger": "side_effecting_action", "tool": "commit_changes", "args": {"branch": "fix/fin-212-half-even-rounding", "message": "fix: use banker's rounding for money per FIN-212", "files": [{"path": "src/money.py", "content": "from decimal import Decimal, ROUND_HALF_EVEN\n\n\ndef round_money(amount: Decimal) -> Decimal:\n    \"\"\"Round to cents using banker's rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_half_even_near_zero():\n    assert round_money(Decimal(\"0.005\")) == Decimal(\"0.00\")\n    assert round_money(Decimal(\"0.015\")) == Decimal(\"0.02\")\n\n\ndef test_round_money_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}]}, "question": null, "context": {"authority": [], "confidence": null, "semantics": {"side_effect": "internal", "idempotent": true, "reversible": true, "compensable": true, "consequence": "LOW", "authority_requirement": null, "supports_idempotency_key": false, "multipart": false}}}, {"t_ms": 272952, "event": "human_response", "actor": "human", "escalation": "esc2", "decision": "approv