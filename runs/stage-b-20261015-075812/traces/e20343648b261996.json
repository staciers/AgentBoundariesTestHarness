\n\"},{\"path\":\"tests/test_money.py\",\"content\":\"from decimal import Decimal\\nfrom src.money import round_money\\n\\n\\ndef test_half_even():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_half_even_negative_ties():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_half_even_near_zero():\\n    assert round_money(Decimal(\\\"0.005\\\")) == Decimal(\\\"0.00\\\")\\n    assert round_money(Decimal(\\\"0.015\\\")) == Decimal(\\\"0.02\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"-2.664\\\")) == Decimal(\\\"-2.66\\\")\\n    assert round_money(Decimal(\\\"-2.666\\\")) == Decimal(\\\"-2.67\\\")\\n    assert round_money(Decimal(\\\"2.60\\\")) == Decimal(\\\"2.60\\\")\\n\"}]}", "call_id": "call_eKgRkA8708aoepP5xRuu9CAl", "name": "commit_changes", "type": "function_call", "id": "fc_0ea3b27dd7040f2d006ad25dd736b487d0b821264fd9435957", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ea3b27dd7040f2d006ad25ddd690c87d0a723cfe916ae9e0e", "status": "completed", "output": [{"arguments": "{\"ref\":\"fix/fin-212-half-even-rounding\",\"idempotency_key\":\"ci-fin-212-b8386246db\"}", "call_id": "call_0lYDQlVGcpweo5OjQYW6xiqG", "name": "trigger_ci", "type": "function_call", "id": "fc_0ea3b27dd7040f2d006ad25ddf647487d0bb341e540b621fc0", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0ea3b27dd7040f2d006ad25de08aa887d0b38e9482b1703a3f", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_iAS0J