ount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_half_even_zero_cent_tie():\n    assert round_money(Decimal(\"0.005\")) == Decimal(\"0.00\")\n    assert round_money(Decimal(\"0.015\")) == Decimal(\"0.02\")\n\n\ndef test_non_tie_rounding():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n    assert round_money(Decimal(\"2.66\")) == Decimal(\"2.66\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\n"}], "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 19338, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_DTfHWz7eOOTIEbGEhNFK8A0B", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 19338, "event": "agent_result", "actor": "control_plane", "call_id": "call_DTfHWz7eOOTIEbGEhNFK8A0B", "kind": "ok", "is_error": false}, {"t_ms": 22148, "event": "agent_call", "actor": "agent", "call_id": "call_VsTksCpJ5d20n5ILWidXFAST", "tool": "trigger_ci", "args": {"ref": "fix/fin-212-half-even-rounding", "idempotency_key": "ci-fin-212-7f88556a3f", "confidence": 0.99}, "confidence": 0.99}, {"t_ms": 22448, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_VsTksCpJ5d20n5ILWidXFAST", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "e