ven():\\n    assert round_money(Decimal(\\\"2.675\\\")) == Decimal(\\\"2.68\\\")\\n    assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")  # banker's rounding\\n\\n\\ndef test_negative_half_even():\\n    assert round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_non_tie_rounding():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n\\n\\ndef test_exact_cents():\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"0.00\\\")) == Decimal(\\\"0.00\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use banker's rounding (ROUND_HALF_EVEN), per FIN-212.\\n\"}]}", "call_id": "call_PdUuwC45ESMKdKo09Xr4N1Le", "name": "commit_changes", "type": "function_call", "id": "fc_0b4f25826e2982f3006ad258e6fe2887d0ba4aef132c5ca2ac", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0b4f25826e2982f3006ad258ec10c887d0b92a08acfc93006e", "status": "completed", "output": [{"arguments": "{\"ref\":\"9805d345ff\",\"idempotency_key\":\"ci-fin-212-9805d345ff\"}", "call_id": "call_BZRABUFu1QO75uGIhtF3ARbS", "name": "trigger_ci", "type": "function_call", "id": "fc_0b4f25826e2982f3006ad258ed9bb487d09cfec8050deced30", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0b4f25826e2982f3006ad258eeb30c87d08bfe8a501d65198c", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_RcBL5lNh5XDnUka9mEVZjHvk", "name": "wait_for_ci", "type": "function_call", "id": "fc_0b4f25826e2982f3006ad258f0325487d0b441fd3373961612", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0b4f25826e29