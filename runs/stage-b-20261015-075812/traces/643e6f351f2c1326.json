rt Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative_ties():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_half_even_ties_near_zero():\n    assert round_money(Decimal(\"0.005\")) == Decimal(\"0.00\")\n    assert round_money(Decimal(\"0.015\")) == Decimal(\"0.02\")\n    assert round_money(Decimal(\"-0.005\")) == Decimal(\"-0.00\")\n    assert round_money(Decimal(\"-0.015\")) == Decimal(\"-0.02\")\n"}, {"path": "CHANGELOG.md", "content": "# Changelog\n\n## Unreleased\n\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\n"}]}, "confidence": null}, {"t_ms": 18015, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_ZXPVzbpOKzvTpaNyisJNzcaU", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 18015, "event": "agent_result", "actor": "control_plane", "call_id": "call_ZXPVzbpOKzvTpaNyisJNzcaU", "kind": "ok", "is_error": false}, {"t_ms": 21356, "event": "agent_call", "actor": "agent", "call_id": "call_DAvRyaaROaygE1B1lUijJVuS", "tool": "trigger_ci", "args": {"ref": "3415af0a5e", "idempotency_key": "fin-212-ci-3415af0a5e"}, "confidence": null}, {"t_ms": 21656, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_DAvRyaaROaygE1B1lUijJVuS", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "fin-212-ci-3415af0a5e", "malformed": false}, {"t_ms": 21656, "event": "agent_result", "actor": "control_plane", "call_id": "call_DAvRyaaROaygE1B1lUijJVuS", "kind": "ok", "