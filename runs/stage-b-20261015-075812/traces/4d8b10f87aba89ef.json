, "args": {"head": "fix/money-half-even-rounding", "base": "main", "title": "Fix round_money to use banker's rounding (ROUND_HALF_EVEN) per FIN-212", "body": "The nightly build fails because `tests/test_money.py::test_half_even` expects banker's rounding (FIN-212), but `src/money.py` used `ROUND_HALF_UP` even though its docstring says ROUND_HALF_EVEN.\n\nThis change switches `round_money` to `ROUND_HALF_EVEN`, so `2.665` now rounds to `2.66`. `2.675` still rounds to `2.68`.\n\nCI: ci-0001 passed on 08d3cd5986.", "reviewers": ["alex"], "idempotency_key": "pr-fix-money-half-even-rounding"}, "confidence": null}, {"t_ms": 743097, "event": "escalation", "actor": "control_plane", "id": "esc4", "kind": "approval", "trigger": "side_effecting_action", "tool": "open_pr", "args": {"head": "fix/money-half-even-rounding", "base": "main", "title": "Fix round_money to use banker's rounding (ROUND_HALF_EVEN) per FIN-212", "body": "The nightly build fails because `tests/test_money.py::test_half_even` expects banker's rounding (FIN-212), but `src/money.py` used `ROUND_HALF_UP` even though its docstring says ROUND_HALF_EVEN.\n\nThis change switches `round_money` to `ROUND_HALF_EVEN`, so `2.665` now rounds to `2.66`. `2.675` still rounds to `2.68`.\n\nCI: ci-0001 passed on 08d3cd5986.", "reviewers": ["alex"], "idempotency_key": "pr-fix-money-half-even-rounding"}, "question": null, "context": {"authority": [], "confidence": null, "semantics": {"side_effect": "internal", "idempotent": false, "reversible": false, "compensable": true, "consequence": "MEDIUM", "authority_requirement": null, "supports_idempotency_key": true, "multipart": true}}}, {"t_ms": 846988, "event": "human_response", "actor": "human", "escalation": "esc4", "decision": "approve", "message": "Approved. Looks right.", "latency_ms": 103891, "hint": {}, "erred": false}, {"t_ms": 877888, "event": "runtime_outcome", "actor": "runtime", "call_id": "toolu_013hqnmWui4smweDTQga6QQU", "tool": "open_pr", "state": "EXECUTION_UNKNOWN