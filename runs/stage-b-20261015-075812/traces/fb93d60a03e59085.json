 rounding (ROUND_HALF_EVEN), per FIN-212.\"\"\"\n    return amount.quantize(Decimal(\"0.01\"), rounding=ROUND_HALF_EVEN)\n"}, {"path": "tests/test_money.py", "content": "from decimal import Decimal\nfrom src.money import round_money\n\n\ndef test_half_even():\n    assert round_money(Decimal(\"2.675\")) == Decimal(\"2.68\")\n    assert round_money(Decimal(\"2.665\")) == Decimal(\"2.66\")  # banker's rounding\n\n\ndef test_half_even_negative():\n    assert round_money(Decimal(\"-2.675\")) == Decimal(\"-2.68\")\n    assert round_money(Decimal(\"-2.665\")) == Decimal(\"-2.66\")\n\n\ndef test_half_even_near_zero():\n    assert round_money(Decimal(\"0.005\")) == Decimal(\"0.00\")\n    assert round_money(Decimal(\"0.015\")) == Decimal(\"0.02\")\n\n\ndef test_round_non_ties():\n    assert round_money(Decimal(\"2.664\")) == Decimal(\"2.66\")\n    assert round_money(Decimal(\"2.666\")) == Decimal(\"2.67\")\n"}]}, "confidence": null}, {"t_ms": 16861, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_jd6NgvLnc8PqZnGIEIg8qFxE", "tool": "commit_changes", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": null, "malformed": false}, {"t_ms": 16861, "event": "agent_result", "actor": "control_plane", "call_id": "call_jd6NgvLnc8PqZnGIEIg8qFxE", "kind": "ok", "is_error": false}, {"t_ms": 19523, "event": "agent_call", "actor": "agent", "call_id": "call_BSNXPhwVO7ROoseIIUBD7JLh", "tool": "trigger_ci", "args": {"ref": "fe83044fb5", "idempotency_key": "ci-fin-212-fe83044fb5"}, "confidence": null}, {"t_ms": 19823, "event": "runtime_outcome", "actor": "runtime", "call_id": "call_BSNXPhwVO7ROoseIIUBD7JLh", "tool": "trigger_ci", "state": "EXECUTED", "error_kind": null, "error_message": null, "attempts": 1, "runtime_actions": [], "failure_class": null, "idempotency_key": "ci-fin-212-fe83044fb5", "malformed": false}, {"t_ms": 19823, "event": "agent_result", "actor": "control_plane", "call_