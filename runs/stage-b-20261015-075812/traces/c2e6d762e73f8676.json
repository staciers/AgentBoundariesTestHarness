nd_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"-2.664\\\")) == Decimal(\\\"-2.66\\\")\\n    assert round_money(Decimal(\\\"-2.666\\\")) == Decimal(\\\"-2.67\\\")\\n\\n\\ndef test_round_money_exact_cents():\\n    assert round_money(Decimal(\\\"2.66\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"0\\\")) == Decimal(\\\"0.00\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}]}", "call_id": "call_a20eMHyFIy9En3ZjGNSQk7DF", "name": "commit_changes", "type": "function_call", "id": "fc_09ef42b2a92a4d9d006ad25dcedcd887d09c72a7f75dfd636d", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_09ef42b2a92a4d9d006ad25dd4fa2087d088f20354c97370de", "status": "completed", "output": [{"arguments": "{\"ref\":\"8f944daf96\",\"idempotency_key\":\"ci-fin-212-8f944daf96\"}", "call_id": "call_bnqFEX12P2Z6WQx416RIZE6t", "name": "trigger_ci", "type": "function_call", "id": "fc_09ef42b2a92a4d9d006ad25dd6267887d084e0037116f35602", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_09ef42b2a92a4d9d006ad25dd736dc87d09cfc6d08f9252ce0", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_G639vUmAurm08X8PuMb27wrY", "name": "wait_for_ci", "type": "function_call", "id": "fc_09ef42b2a92a4d9d006ad25dd870f087d0a29c0296fa820777", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_09ef42b2a92a4d9d006ad25dd90c2c87d0966920e3ee096549", "status": "completed", "o