t round_money(Decimal(\\\"-2.675\\\")) == Decimal(\\\"-2.68\\\")\\n    assert round_money(Decimal(\\\"-2.665\\\")) == Decimal(\\\"-2.66\\\")\\n\\n\\ndef test_round_money_non_ties():\\n    assert round_money(Decimal(\\\"2.664\\\")) == Decimal(\\\"2.66\\\")\\n    assert round_money(Decimal(\\\"2.666\\\")) == Decimal(\\\"2.67\\\")\\n    assert round_money(Decimal(\\\"2.00\\\")) == Decimal(\\\"2.00\\\")\\n\\n\\ndef test_half_even_independent_of_context():\\n    with localcontext() as context:\\n        context.rounding = ROUND_HALF_UP\\n        assert round_money(Decimal(\\\"2.665\\\")) == Decimal(\\\"2.66\\\")\\n\"},{\"path\":\"CHANGELOG.md\",\"content\":\"# Changelog\\n\\n## Unreleased\\n\\n- Fix money rounding to use ROUND_HALF_EVEN (banker's rounding), per FIN-212.\\n\"}]}", "call_id": "call_DpuVDG5jY74UyTs13G7yIhgi", "name": "commit_changes", "type": "function_call", "id": "fc_0542d14b06061339006ad25a8fe70087d0a6fa03e875ae9a23", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0542d14b06061339006ad25a95bc6887d0804b03a93f3b6a41", "status": "completed", "output": [{"arguments": "{\"ref\":\"65fd8b02b6\",\"idempotency_key\":\"ci-fin-212-65fd8b02b6\"}", "call_id": "call_Ddadx1mbxBZm3tRB15CAn61j", "name": "trigger_ci", "type": "function_call", "id": "fc_0542d14b06061339006ad25a980cfc87d0a9289a287e8ed74f", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0542d14b06061339006ad25a99288887d09ea4b4ef31cdee83", "status": "completed", "output": [{"arguments": "{\"run_id\":\"ci-0001\",\"max_wait_s\":900}", "call_id": "call_Fh1ezGeMiHEVgZkSh3bjFVG6", "name": "wait_for_ci", "type": "function_call", "id": "fc_0542d14b06061339006ad25a9aa0e487d0a3b966303d44bd63", "async_": null, "caller": null, "namespace": null, "status": "completed"}]}, {"response_id": "resp_0542d14b06061339006ad25a9b82c887d0aad72e46c8e9921e", "status": "completed", "output": [{"arguments": "{\"head\":\"fix/fin-212-h