{
  "name": "real-ledger",
  "_comment": "Tier A real-services replication: the ledger on Postgres with a delayed streaming replica, through a fault proxy (ledger_real/base), run side by side with the simulated ledger (ledger/base) on the same models, seeds and arms. Pre-registered in docs/preregistration/real-services.md. Needs services/ledger/stack.sh up. Do not change after the run starts.",
  "agents": [
    {
      "type": "anthropic",
      "model": "claude-opus-5-5",
      "effort": "high"
    },
    {
      "type": "anthropic",
      "model": "claude-haiku-5-5",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    {
      "type": "openai",
      "model": "gpt-6-luna",
      "effort": "high"
    },
    {
      "type": "compat",
      "provider": "together",
      "model": "zai-org/GLM-5.3-Flash",
      "alias": "glm-5.3-flash",
      "effort": "high",
      "input_price": 0.15,
      "output_price": 0.5,
      "cache_read_price": 0.03
    },
    {
      "type": "compat",
      "provider": "together",
      "model": "deepseek-ai/DeepSeek-V4.1-Flash-1017",
      "alias": "deepseek-v4.1-flash-1017",
      "effort": "high",
      "input_price": 0.3,
      "output_price": 1.2,
      "cache_read_price": 0.006
    }
  ],
  "human": {
    "latency_median_s": 90,
    "latency_sigma": 0.8,
    "cost_per_hour": 120,
    "error_rate": 0.03,
    "fatigue_per_request": 0.01
  },
  "principal_replies": 1,
  "keep_traces": true,
  "workers": {
    "anthropic": 8,
    "openai": 8,
    "together": 12,
    "scripted": 4
  },
  "blocks": [
    {
      "_block": "N: no fault, agent recovers alone (P1, keys offered)",
      "scenarios": [
        "ledger_real/base",
        "ledger/base"
      ],
      "fault_conditions": [
        "none"
      ],
      "policies": [
        "P1"
      ],
      "seeds": {
        "start": 600,
        "count": 30
      }
    },
    {
      "_block": "L: visibility lag only (a successful payment stays hidden for 9 s)",
      "fault_conditions": [
        [
          {
            "type": "delayed_visibility",
            "params": {
              "delay_ms": 9000
            }
          }
        ]
      ],
      "policies": [
        "P1"
      ],
      "scenarios": [
        "ledger_real/base",
        "ledger/base"
      ],
      "seeds": {
        "start": 600,
        "count": 30
      }
    },
    {
      "_block": "HW: hidden write, no keys vs runtime",
      "scenarios": [
        "ledger_real/base",
        "ledger/base"
      ],
      "fault_conditions": [
        [
          "timeout_after_execution",
          "delayed_visibility"
        ]
      ],
      "policies": [
        {
          "name": "P1",
          "expose_keys": false
        },
        {
          "name": "P6",
          "threshold": 0.7
        }
      ],
      "seeds": {
        "start": 600,
        "count": 30
      }
    },
    {
      "_block": "PC: hidden partial commit, keys vs no keys vs runtime",
      "scenarios": [
        "ledger_real/base",
        "ledger/base"
      ],
      "fault_conditions": [
        [
          "partial_mutation",
          "timeout_after_execution"
        ]
      ],
      "policies": [
        "P1",
        {
          "name": "P1",
          "expose_keys": false
        },
        {
          "name": "P6",
          "threshold": 0.7
        }
      ],
      "seeds": {
        "start": 600,
        "count": 30
      }
    }
  ]
}